import os
import json
import google.generativeai as genai
from dotenv import load_dotenv

load_dotenv()

api_key = os.getenv("GEMINI_API_KEY")
genai.configure(api_key=api_key)

model = genai.GenerativeModel("gemini-2.0-flash")


def analyze_resume_with_ai(resume_text: str, target_niche: str) -> dict:
    """
    Resume text aur target niche/field Gemini ko bhejta hai,
    aur structured JSON response (score + feedback + suggestions) wapas deta hai
    """

    prompt = f"""
You are an expert ATS (Applicant Tracking System) analyst and professional resume reviewer.

A candidate is targeting a role in this field/niche: "{target_niche}"

Here is their resume text (extracted from PDF/DOCX):
---
{resume_text}
---

Analyze this resume specifically for the "{target_niche}" field and return a JSON object with EXACTLY this structure (no extra text, no markdown, just raw JSON):

{{
  "ats_score": <number between 0-100>,
  "overall_verdict": "<one short sentence: is this resume good, average, or weak for this niche>",
  "strengths": ["<strength 1>", "<strength 2>", "<strength 3>"],
  "weaknesses": ["<weakness 1>", "<weakness 2>", "<weakness 3>"],
  "missing_skills": ["<skill or keyword missing for this niche>", "..."],
  "suggestions": ["<specific actionable suggestion 1>", "<specific actionable suggestion 2>", "<specific actionable suggestion 3>"]
}}

Be honest and specific to the "{target_niche}" field. Base the score on real ATS parsing factors (keyword relevance, structure, clarity) and how well this resume fits that specific niche.
"""

    try:
        response = model.generate_content(prompt)
        raw_text = response.text.strip()

        # Gemini kabhi kabhi ```json ... ``` wrap kar deta hai — usko clean karo
        if raw_text.startswith("```"):
            raw_text = raw_text.strip("`")
            raw_text = raw_text.replace("json", "", 1).strip()

        result = json.loads(raw_text)
        return result

    except json.JSONDecodeError:
        return {
            "error": "AI response could not be parsed. Please try again."
        }
    except Exception as e:
        return {
            "error": f"AI analysis failed: {str(e)}"
        }